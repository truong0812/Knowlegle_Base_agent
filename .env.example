# LLM Configuration for AI enrichment
# Copy this file to .env and fill in your values

# OpenAI API key (required for AI enrichment, skip with --skip-ai)
OPENAI_API_KEY=sk-your-api-key-here

# Custom base URL (optional, for compatible providers like Azure OpenAI, Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (optional, overrides --model CLI flag)
# OPENAI_MODEL=gpt-4o
